# ── GitHub ───────────────────────────────────────────────────────────────────
# Your GitHub username (required)
GITHUB_USERNAME=vishalkonduru

# Personal Access Token — increases rate limit from 60 to 5000 req/hr
# Create one at: https://github.com/settings/tokens (read:user scope is enough)
GITHUB_TOKEN=

# ── Flask ────────────────────────────────────────────────────────────────────
FLASK_DEBUG=false
SECRET_KEY=change-me-in-production

# ── Cache ────────────────────────────────────────────────────────────────────
# Leave blank to use in-memory SimpleCache (fine for single-container setups)
# Set to redis://localhost:6379/0 when running with docker-compose
REDIS_URL=

# How long to cache GitHub API responses (seconds)
CACHE_TIMEOUT=300
